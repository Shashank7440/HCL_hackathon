OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_PROVIDER=ollama
MOCK_LLM=false
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PATH=data/chroma
DB_PATH=data/app.db
TOP_K=6
MIN_SCORE=0.40
CHUNK_TOKENS=400
CHUNK_OVERLAP=60
ADMIN_KEY=admin-demo-key
LLM_TIMEOUT_S=60
AUTO_EXTRACT_RULES=false
